{
  "info": {
    "name": "POS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "superAdminToken", "value": "" },
    { "key": "tenantToken", "value": "" },
    { "key": "tenantId", "value": "" },
    { "key": "staffId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "brandId", "value": "" }
  ],
  "item": [
    {
      "name": "Platform Auth",
      "item": [
        {
          "name": "Super Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('superAdminToken', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@shreespark.com\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/platform/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["platform", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Platform Tenants",
      "item": [
        {
          "name": "Create Tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set('tenantId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"ABC Store\",\n  \"email\": \"owner@abcstore.com\",\n  \"phone\": \"9999999999\",\n  \"address\": \"Mumbai\",\n  \"gstin\": \"27XXXXX\",\n  \"subscriptionPlan\": \"BASIC\",\n  \"subscriptionExpiry\": \"2026-12-31\",\n  \"adminName\": \"Store Owner\",\n  \"adminPassword\": \"Owner@1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/platform/tenants",
              "host": ["{{baseUrl}}"],
              "path": ["platform", "tenants"]
            }
          }
        },
        {
          "name": "Get All Tenants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{superAdminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/platform/tenants",
              "host": ["{{baseUrl}}"],
              "path": ["platform", "tenants"]
            }
          }
        },
        {
          "name": "Get Tenant By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{superAdminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/platform/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["platform", "tenants", "{{tenantId}}"]
            }
          }
        },
        {
          "name": "Update Tenant",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superAdminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"ABC Store Updated\",\n  \"phone\": \"8888888888\",\n  \"address\": \"Delhi\",\n  \"gstin\": \"07XXXXX\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/platform/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["platform", "tenants", "{{tenantId}}"]
            }
          }
        },
        {
          "name": "Deactivate Tenant",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{superAdminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/platform/tenants/{{tenantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["platform", "tenants", "{{tenantId}}"]
            }
          }
        }
      ]
    },
